# 🔑 OpenRouter API Key
# Get it from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 🗄️ MongoDB URI
# ⚠️ IMPORTANT FOR RENDER:
# You MUST use a remote MongoDB instance (Atlas, Azure Cosmos DB, AWS DocumentDB, etc.)
# Local MongoDB (mongodb://localhost:27017/) will NOT work on Render
# Atlas (recommended): mongodb+srv://username:password@cluster.mongodb.net/ai_queries
# Azure Cosmos: mongodb+srv://username:password@cluster.mongo.cosmos.azure.com/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ai_queries

# 🖼️ ImageKit Configuration
# Get from: https://imagekit.io/dashboard
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# 🌐 Server Configuration
PORT=5000

# For Render deployment - auto-set by Render
# RENDER_EXTERNAL_URL=https://your-service.onrender.com
# Or set manually:
# APP_URL=https://your-domain.com

# Environment
NODE_ENV=production
