# 🔑 OpenRouter API Key
# Get it from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 🗄️ MongoDB URI
# Local: mongodb://localhost:27017/ai_queries
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/ai_queries
MONGODB_URI=mongodb://localhost:27017/ai_queries

# 🖼️ ImageKit Configuration
# Get from: https://imagekit.io/dashboard
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# 🌐 Server Port (optional)
PORT=5000
